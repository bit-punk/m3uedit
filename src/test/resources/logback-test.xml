<?xml version="1.0" encoding="UTF-8"?>
<!-- used instead of logback.xml when running tests: less noise than the DEBUG output of the application -->
<configuration debug="false" scan="false">

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} [%t] %5p \(%C{1}:%L %M\) - %m%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
