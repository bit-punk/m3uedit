---
name: Kurt
inputs:
  - type: FileInput
    enabled: true
    source: ""
  - type: FritzBoxInput
    enabled: false
    selectedStreamSources:
      - name: tvsd.m3u
        description: SD streams
      - name: tvhd.m3u
        description: HD streams
    fritzBoxConnection:
      baseUrl: http://fritz.box/dvb/m3u/
      selectedStreamSources:
        - name: tvsd.m3u
          description: SD streams
        - name: tvhd.m3u
          description: HD streams
filters:
  - type: ChannelNameFilter
    enabled: false
  - type: UniqueNameFilter
    enabled: true
  - type: SdChannelFilter
    enabled: false
sorters:
  - type: ChannelNameSorter
    enabled: true
outputs:
  - type: FileOutput
    enabled: true
    output: file:///tmp/playlist.m3u
