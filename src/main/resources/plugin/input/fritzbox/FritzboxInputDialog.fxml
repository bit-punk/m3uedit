<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="520">

    <content>
        <GridPane hgap="8" vgap="8">
            <Label text="Recent:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="recentConnectionsComboBox" promptText="recently used FritzBoxes" maxWidth="Infinity"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button fx:id="removeRecentConnectionButton" text="Remove" onAction="#handleRemoveRecentConnection"
                    GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <Separator GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3"/>

            <Label text="Fritzbox-Base-URL:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="baseUrlTextField" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="2"
                       text="http://fritz.box/dvb/m3u/"/>
            <Label text="Streams to import:" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.valignment="TOP"/>
            <ListView fx:id="availableStreamSources" prefHeight="62" GridPane.columnIndex="1" GridPane.rowIndex="3"
                      GridPane.columnSpan="2"/>
            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints/>
            </columnConstraints>
        </GridPane>
    </content>

    <ButtonType fx:id="okButtonType" text="Ok" buttonData="OK_DONE"/>
    <ButtonType text="Cancel" buttonData="CANCEL_CLOSE"/>
</DialogPane>
