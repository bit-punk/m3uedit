<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefHeight="150" prefWidth="500">

    <content>
        <GridPane hgap="5" vgap="5">
            <Label text="Input-URL:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="urlTextField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button fx:id="addUrlButton" text="Add Url" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label text="URLs to import:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ListView fx:id="selectedUrlListView" VBox.vgrow="ALWAYS" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
        </GridPane>
    </content>

    <ButtonType fx:id="okButtonType" text="Ok" buttonData="OK_DONE"/>
    <ButtonType text="Cancel" buttonData="CANCEL_CLOSE"/>
</DialogPane>