<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<DialogPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="650" prefHeight="520">
    <content>
        <VBox spacing="12">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <VBox spacing="6">
                <Label text="Profile:" style="-fx-font-weight: bold;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="profileComboBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="addProfileButton" text="New..."/>
                    <Button fx:id="createFromPlaylistButton" text="From Playlist..."/>
                    <Button fx:id="renameProfileButton" text="Rename..."/>
                    <Button fx:id="deleteProfileButton" text="Delete"/>
                </HBox>
                <CheckBox fx:id="defaultProfileCheckBox" text="Default profile"/>
            </VBox>
            <Separator/>
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label text="Preferred Channel Order:" style="-fx-font-weight: bold;"/>
                <HBox spacing="8" VBox.vgrow="ALWAYS">
                    <ListView fx:id="channelsListView" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" prefHeight="280"/>
                    <VBox spacing="8" alignment="TOP_CENTER">
                        <Button fx:id="moveUpButton" minWidth="42" minHeight="36">
                            <graphic>
                                <SVGPath content="M7 14l5-5 5 5z" scaleX="1.6" scaleY="1.6"/>
                            </graphic>
                        </Button>
                        <Button fx:id="moveDownButton" minWidth="42" minHeight="36">
                            <graphic>
                                <SVGPath content="M7 10l5 5 5-5z" scaleX="1.6" scaleY="1.6"/>
                            </graphic>
                        </Button>
                        <Separator/>
                        <Button fx:id="removeChannelButton" text="Remove" minWidth="70"/>
                    </VBox>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="newChannelTextField" promptText="Enter channel name to add..." HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addChannelButton" text="Add"/>
                </HBox>
            </VBox>
        </VBox>
    </content>

    <ButtonType fx:id="okButtonType" text="Ok" buttonData="OK_DONE"/>
    <ButtonType text="Cancel" buttonData="CANCEL_CLOSE"/>
</DialogPane>
