<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Scene fx:id="scene" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="org.bitpunk.m3uedit.controller.SceneController">
    <BorderPane>
        <top>
            <MenuBar>
                <Menu text="File">
                    <MenuItem onAction="#handleExitAction" text="Exit"/>
                </Menu>
            </MenuBar>
        </top>
        <center>
            <ScrollPane fitToHeight="true" fitToWidth="true">
                <VBox>
                    <TitledPane animated="false" text="Input">
                        <VBox>
                            <TableView fx:id="inputTableView" onKeyPressed="#deleteKeyListenerTableView">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                            <ComboBox fx:id="addInputComboBox" onAction="#addInputAction"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Filters">
                        <VBox>
                            <ListView fx:id="availableFiltersListView"/>
                            <Button mnemonicParsing="false" onAction="#applySelectedFilterAction"
                                    text="Apply selected Filters"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Sorters">
                        <VBox>
                            <ListView fx:id="availableSortersListView"/>
                            <Button mnemonicParsing="false" onAction="#applySelectedSorterAction"
                                    text="Apply selected Sorters"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Resulting List">
                        <VBox>
                            <TableView fx:id="entryTableView" editable="true" onKeyPressed="#deleteKeyListenerTableView"
                                       GridPane.columnIndex="0" GridPane.columnSpan="1" GridPane.hgrow="ALWAYS"
                                       GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="indexColumn" text="Index" maxWidth="70"/>
                                    <TableColumn fx:id="channelName" text="Channel Name" minWidth="50" prefWidth="150"
                                                 maxWidth="700"/>
                                    <TableColumn fx:id="channelUri" text="Channel URI" minWidth="50" prefWidth="300"
                                                 maxWidth="700"/>
                                </columns>
                            </TableView>
                            <HBox spacing="3.0">
                                <Button onAction="#populateEntryTable" text="Load Data"/>
                                <Button fx:id="addEntryButton" mnemonicParsing="false" onAction="#addNewEntry"
                                        text="Add new Entry"/>
                            </HBox>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Output">
                        <VBox>
                            <TableView fx:id="outputTableView" onKeyPressed="#deleteKeyListenerTableView">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                            <HBox>
                                <ComboBox fx:id="addOutputComboBox" onAction="#addOutputAction"/>
                                <Button fx:id="saveFileButton" mnemonicParsing="false" onAction="#saveListToOutputs"
                                        text="Save Playlist"/>
                            </HBox>
                        </VBox>
                    </TitledPane>
                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</Scene>
