<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Scene?>
<Scene fx:id="scene" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="org.bitpunk.m3uedit.controller.SceneController">
    <BorderPane prefHeight="400.0" prefWidth="600.0">
        <top>
            <MenuBar>
                <Menu text="File">
                    <MenuItem onAction="#handleExitAction" text="Exit"/>
                </Menu>
            </MenuBar>
        </top>
        <center>
            <ScrollPane>
                <VBox layoutX="1.0" layoutY="2.0" prefHeight="397.0" prefWidth="595.0">
                    <TitledPane animated="false" text="Input">
                        <VBox>
                            <ComboBox fx:id="addInputComboBox" onAction="#addInputAction"/>
                            <TableView fx:id="inputTableView"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Filters">
                        <VBox>
                            <ListView fx:id="availableFiltersListView"/>
                            <Button mnemonicParsing="false" onAction="#applySelectedFilterAction"
                                    text="Apply selected Filters"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Sorters">
                        <VBox>
                            <ListView fx:id="availableSortersListView"/>
                            <Button mnemonicParsing="false" onAction="#applySelectedSorterAction"
                                    text="Apply selected Sorters"/>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Resulting List">
                        <VBox>
                            <Button onAction="#populateEntryTable" text="Load Data"/>
                            <TableView fx:id="entryTableView" editable="true" onKeyPressed="#deleteKeyListener"
                                       prefHeight="409.0" prefWidth="595.0" GridPane.columnIndex="0"
                                       GridPane.columnSpan="1"
                                       GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="indexColumn" prefWidth="107.0" text="Index"/>
                                    <TableColumn fx:id="channelName" prefWidth="107.0" text="Channel Name"/>
                                    <TableColumn fx:id="channelUri" prefWidth="86.0" text="Channel URI"/>
                                </columns>
                            </TableView>
                            <HBox prefHeight="100.0" prefWidth="595.0" spacing="3.0">
                                <TextField fx:id="addedChannelNameTextField" promptText="Channel Name"/>
                                <TextField fx:id="addedChannelUriTextField" promptText="ChannelUri"/>
                                <Button fx:id="addEntryButton" mnemonicParsing="false" onAction="#addEntry"
                                        text="Add"/>
                            </HBox>
                        </VBox>
                    </TitledPane>
                    <TitledPane animated="false" text="Output">
                        <VBox>
                            <ComboBox fx:id="addOutputComboBox" onAction="#addOutputAction"/>
                            <TableView fx:id="outputTableView"/>
                            <Button fx:id="saveFileButton" mnemonicParsing="false" onAction="#saveListToOutputs"
                                    text="Save Playlist"/>
                        </VBox>
                    </TitledPane>
                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>
</Scene>
