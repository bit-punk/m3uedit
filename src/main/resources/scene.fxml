<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Scene xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="org.bitpunk.m3uedit.controller.SceneController">
    <AnchorPane prefHeight="400.0" prefWidth="600.0">
        <children>
            <VBox layoutX="1.0" layoutY="2.0" prefHeight="397.0" prefWidth="595.0">
                <children>
                    <HBox prefHeight="100.0" prefWidth="595.0" spacing="3.0">
                        <TextField fx:id="fileNameTextField" promptText="Filename"/>
                        <Button fx:id="openFileButton" mnemonicParsing="false" text="Open File"/>
                    </HBox>
                    <Separator prefWidth="200.0"/>
                    <Label text="Channel list">
                        <font>
                            <Font size="20.0"/>
                        </font>
                    </Label>
                    <TableView fx:id="entryTableView" editable="true" prefHeight="409.0" prefWidth="595.0">
                        <columns>
                            <TableColumn fx:id="indexColumn" prefWidth="107.0" text="Pos"/>
                            <TableColumn fx:id="channelName" prefWidth="107.0" text="Channel Name"/>
                            <TableColumn fx:id="channelUri" prefWidth="86.0" text="Channel URI"/>
                        </columns>
                    </TableView>
                    <HBox prefHeight="100.0" prefWidth="595.0" spacing="3.0">
                        <TextField fx:id="addedChannelNameTextField" promptText="Channel Name"/>
                        <TextField fx:id="addedChannelUriTextField" promptText="ChannelUri"/>
                        <Button fx:id="addEntryButton" mnemonicParsing="false" text="Add"/>
                    </HBox>
                    <Separator prefWidth="200.0"/>
                    <HBox prefHeight="100.0" prefWidth="595.0" spacing="3.0">
                        <TextField fx:id="targetFileNameTextField" promptText="Filename"/>
                        <Button fx:id="saveFileButton" mnemonicParsing="false" text="Save File"/>
                    </HBox>

                </children>
            </VBox>
        </children>
    </AnchorPane>
</Scene>
