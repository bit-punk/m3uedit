<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<fx:root stylesheets="@css/project.css" type="javafx.scene.layout.VBox" xmlns:fx="http://javafx.com/fxml/1"
         xmlns="http://javafx.com/javafx/17.0.2-ea">
    <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
        <TabPane rotateGraphic="true" side="LEFT" tabClosingPolicy="UNAVAILABLE"
                 xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
            <Tab fx:id="inputTab" text="Inputs"/>
            <Tab fx:id="filterTab" text="Filters"/>
            <Tab fx:id="sorterTab" text="Sorters"/>
            <Tab fx:id="entryTab" text="Playlist"/>
            <Tab fx:id="outputTab" text="Outputs"/>
        </TabPane>
    </ScrollPane>
</fx:root>