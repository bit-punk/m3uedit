<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.Scene?>
<Scene fx:id="scene" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="org.bitpunk.m3uedit.controller.SceneController" stylesheets="@css/scene.css">
    <BorderPane>
        <top>
            <MenuBar>
                <Menu text="File">
                    <MenuItem onAction="#handleExitAction" text="Exit"/>
                </Menu>
            </MenuBar>
        </top>
        <center>
            <ScrollPane fitToHeight="true" fitToWidth="true">
                <TabPane rotateGraphic="true"
                        side="LEFT" tabClosingPolicy="UNAVAILABLE"
                        xmlns:fx="http://javafx.com/fxml/1"
                        xmlns="http://javafx.com/javafx/17.0.2-ea">
                    <Tab text="Inputs" fx:id="inputTab"/>
                    <Tab text="Filters" fx:id="filterTab"/>
                    <Tab text="Sorters" fx:id="sorterTab"/>
                    <Tab text="Playlist" fx:id="entryTab"/>
                    <Tab text="Outputs" fx:id="outputTab"/>
                </TabPane>
            </ScrollPane>
        </center>
        <bottom>
            <HBox>
                <Label fx:id="statusLabel"/>
            </HBox>
        </bottom>
    </BorderPane>
</Scene>