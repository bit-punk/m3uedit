<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.scene.layout.VBox" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea">
    <TableView fx:id="entryTableView" editable="true" GridPane.columnIndex="0" GridPane.columnSpan="1"
               GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="indexColumn" maxWidth="70" text="Index"/>
            <TableColumn fx:id="channelNameColumn" maxWidth="700" minWidth="50" prefWidth="200" text="Channel Name"/>
            <TableColumn fx:id="tvgIdColumn" maxWidth="400" minWidth="50" prefWidth="120" text="tvg-id"/>
            <TableColumn fx:id="channelUriColumn" maxWidth="700" minWidth="50" prefWidth="300" text="Channel URI"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button fx:id="addNewEntryButton" mnemonicParsing="false" text="Add new Entry"/>
        <Button fx:id="resetManualChangesButton" mnemonicParsing="false" text="Reset manual Changes"/>
        <Button fx:id="epgButton" mnemonicParsing="false" text="EPG"/>
    </HBox>

</fx:root>