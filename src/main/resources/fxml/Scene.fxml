<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.Scene?>
<Scene fx:id="scene" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="org.bitpunk.m3uedit.controller.SceneController">
    <BorderPane prefWidth="800" prefHeight="640">
        <top>
            <MenuBar>
                <Menu text="File">
                    <MenuItem onAction="#handleNewProjectAction" text="New Project">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="N" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                        </accelerator>
                    </MenuItem>
                    <MenuItem onAction="#handleExitAction" text="Exit"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem onAction="#handleAboutAction" text="About"/>
                </Menu>
            </MenuBar>
        </top>
        <center>
            <TabPane fx:id="tabPane"/>
        </center>
        <bottom>
            <HBox>
                <Label fx:id="statusLabel"/>
            </HBox>
        </bottom>
    </BorderPane>
</Scene>