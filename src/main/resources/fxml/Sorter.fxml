<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<fx:root type="javafx.scene.layout.VBox" xmlns:fx="http://javafx.com/fxml">
    <TableView fx:id="availableSortersTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="selectedColumn" prefWidth="50.0" style="-fx-alignment: CENTER;">
                <graphic>
                    <CheckBox fx:id="selectAllEntriesCheckBox" mnemonicParsing="false" />
                </graphic>
            </TableColumn>
            <TableColumn fx:id="indexColumn" maxWidth="70" text="Index"/>
            <TableColumn fx:id="sorterNameColumn" maxWidth="700" minWidth="50" prefWidth="150" text="Sorter Name"/>
            <TableColumn fx:id="sorterDescriptionColumn" maxWidth="700" minWidth="50" prefWidth="300" text="Sorter description"/>
        </columns>
    </TableView>
</fx:root>