<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<fx:root type="javafx.scene.layout.VBox" xmlns:fx="http://javafx.com/fxml" styleClass="map-editor"
         stylesheets="@css/validating-cell.css">
    <TableView fx:id="vlcOptionsTableView" editable="true">
        <placeholder>
            <Label text="%mapEditor.empty" styleClass="map-editor-empty"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="keyColumn" text="%mapEditor.column.key"/>
            <TableColumn fx:id="valueColumn" text="%mapEditor.column.value"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <HBox styleClass="map-editor-add">
        <TextField fx:id="newKeyTextField" promptText="%mapEditor.newKey.prompt" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="newValueTextField" promptText="%mapEditor.newValue.prompt" HBox.hgrow="ALWAYS"/>
        <Button fx:id="addNewPropertyButton" text="%common.add"/>
    </HBox>
</fx:root>
