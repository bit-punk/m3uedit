<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<fx:root type="javafx.scene.layout.VBox" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea">
    <!-- filters the entries shown, the playlist itself is not changed -->
    <HBox fx:id="searchBar" spacing="6" alignment="CENTER_LEFT" styleClass="playlist-search">
        <TextField fx:id="searchField" promptText="%playlist.search.prompt" HBox.hgrow="ALWAYS"/>
        <Button fx:id="clearSearchButton" text="✕" mnemonicParsing="false" focusTraversable="false"/>
        <Label fx:id="searchResultLabel" styleClass="playlist-search-result"/>
    </HBox>
    <TableView fx:id="entryTableView" editable="true" GridPane.columnIndex="0" GridPane.columnSpan="1"
               GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="indexColumn" maxWidth="70" text="%playlist.column.index"/>
            <TableColumn fx:id="channelNameColumn" maxWidth="700" minWidth="50" prefWidth="200" text="%playlist.column.channelName"/>
            <TableColumn fx:id="tvgIdColumn" maxWidth="400" minWidth="50" prefWidth="120" text="%playlist.column.tvgId"/>
            <TableColumn fx:id="channelUriColumn" maxWidth="700" minWidth="50" prefWidth="300" text="%playlist.column.channelUri"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button fx:id="addNewEntryButton" mnemonicParsing="false" text="%playlist.addEntry"/>
        <Button fx:id="resetManualChangesButton" mnemonicParsing="false" text="%playlist.resetManualChanges"/>
        <Button fx:id="epgButton" mnemonicParsing="false" text="%playlist.epg"/>
    </HBox>

</fx:root>