<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Scene?>
<?import javafx.scene.shape.SVGPath?>
<Scene xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="org.bitpunk.m3uedit.controller.SceneController"
       stylesheets="@css/scene.css">
    <BorderPane prefWidth="1200" prefHeight="800">
        <top>
            <VBox>
                <MenuBar>
                    <Menu text="%menu.file">
                        <MenuItem fx:id="newProjectMenuItem" onAction="#handleNewProjectAction" text="%menu.file.newProject">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="N" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="openProjectMenuItem" onAction="#handleOpenProjectAction" text="%menu.file.openProject">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="O" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <Menu fx:id="recentProjectsMenu" text="%menu.file.openRecent"/>
                        <MenuItem fx:id="saveProjectMenuItem" disable="true" onAction="#handleSaveProjectAction" text="%menu.file.saveProject">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="S" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="saveProjectAsMenuItem" disable="true" onAction="#handleSaveProjectAsAction" text="%menu.file.saveProjectAs">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="S" control="DOWN" meta="UP" shift="DOWN" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="closeProjectMenuItem" disable="true" onAction="#handleCloseProjectAction" text="%menu.file.closeProject">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="W" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem onAction="#handleConfigurationAction" text="%menu.file.configuration">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="COMMA" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                            </accelerator>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem onAction="#handleExitAction" text="%menu.file.exit"/>
                    </Menu>
                    <Menu fx:id="editMenu" text="%menu.edit">
                        <MenuItem fx:id="undoMenuItem" onAction="#handleUndoAction" text="%menu.edit.undo">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="Z" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="redoMenuItem" onAction="#handleRedoAction" text="%menu.edit.redo">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="Y" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                            </accelerator>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="cutMenuItem" onAction="#handleCutAction" text="%menu.edit.cut">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="X" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="copyMenuItem" onAction="#handleCopyAction" text="%menu.edit.copy">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="C" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="pasteMenuItem" onAction="#handlePasteAction" text="%menu.edit.paste">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="V" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="deleteMenuItem" onAction="#handleDeleteAction" text="%menu.edit.delete">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="DELETE" control="UP" meta="UP" shift="UP" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="selectAllMenuItem" onAction="#handleSelectAllAction" text="%menu.edit.selectAll">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="A" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="editEntryMenuItem" onAction="#handleEditEntryAction" text="%menu.edit.editEntry">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="ENTER" control="UP" meta="UP" shift="UP" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="resetManualChangesMenuItem" onAction="#handleResetManualChangesAction"
                                  text="%menu.edit.resetManualChanges"/>
                    </Menu>
                    <Menu fx:id="projectMenu" text="%menu.project">
                        <MenuItem fx:id="reloadInputsMenuItem" onAction="#handleReloadInputsAction" text="%menu.project.reloadInputs">
                            <accelerator>
                                <KeyCodeCombination alt="UP" code="F5" control="UP" meta="UP" shift="UP" shortcut="UP" />
                            </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="writePlaylistMenuItem" onAction="#handleWritePlaylistAction" text="%menu.project.writePlaylist"/>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="programmeGuideMenuItem" onAction="#handleProgrammeGuideAction" text="%menu.project.programmeGuide"/>
                    </Menu>
                    <Menu text="%menu.help">
                        <MenuItem onAction="#handlePluginsAction" text="%menu.help.plugins"/>
                        <MenuItem onAction="#handleAboutAction" text="%menu.help.about"/>
                    </Menu>
                </MenuBar>
                <!-- direct access to the most important functions, the same actions as the menus -->
                <ToolBar fx:id="toolBar" styleClass="main-toolbar">
                    <Button fx:id="newProjectToolButton" onAction="#handleNewProjectAction" styleClass="tool-button"/>
                    <SplitMenuButton fx:id="openProjectToolButton" onAction="#handleOpenProjectAction"
                                     styleClass="tool-button"/>
                    <Button fx:id="saveProjectToolButton" onAction="#handleSaveProjectAction" styleClass="tool-button"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="undoToolButton" onAction="#handleUndoAction" styleClass="tool-button"/>
                    <Button fx:id="redoToolButton" onAction="#handleRedoAction" styleClass="tool-button"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="reloadInputsToolButton" onAction="#handleReloadInputsAction" styleClass="tool-button"/>
                    <Button fx:id="writePlaylistToolButton" onAction="#handleWritePlaylistAction" styleClass="tool-button"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="addEntryToolButton" onAction="#handleAddEntryAction" styleClass="tool-button"/>
                    <Button fx:id="playToolButton" onAction="#handlePlayAction" styleClass="tool-button"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="programmeGuideToolButton" onAction="#handleProgrammeGuideAction" styleClass="tool-button"/>
                </ToolBar>
            </VBox>
        </top>
        <center>
            <StackPane>
                <VBox fx:id="startScreen" styleClass="start-screen">
                    <Label text="m3uedit" styleClass="start-screen-title"/>
                    <HBox alignment="CENTER" spacing="25">
                        <Button fx:id="newProjectButton" onAction="#handleNewProjectAction" contentDisplay="TOP" text="%startScreen.newProject" styleClass="start-screen-button">
                            <graphic>
                                <StackPane prefWidth="64" prefHeight="64">
                                    <SVGPath fx:id="newProjectIcon" scaleX="2.2" scaleY="2.2" styleClass="start-screen-icon"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="openProjectButton" onAction="#handleOpenProjectAction" contentDisplay="TOP" text="%startScreen.openProject" styleClass="start-screen-button">
                            <graphic>
                                <StackPane prefWidth="64" prefHeight="64">
                                    <SVGPath fx:id="openProjectIcon" scaleX="2.2" scaleY="2.2" styleClass="start-screen-icon"/>
                                </StackPane>
                            </graphic>
                        </Button>
                        <Button fx:id="aboutButton" onAction="#handleAboutAction" contentDisplay="TOP" text="%startScreen.about" styleClass="start-screen-button">
                            <graphic>
                                <StackPane prefWidth="64" prefHeight="64">
                                    <SVGPath fx:id="aboutIcon" scaleX="2.2" scaleY="2.2" styleClass="start-screen-icon"/>
                                </StackPane>
                            </graphic>
                        </Button>
                    </HBox>
                    <VBox fx:id="recentProjectsBox" styleClass="recent-projects">
                        <Label text="%startScreen.recentProjects" styleClass="recent-projects-title"/>
                        <TableView fx:id="recentProjectsTable" styleClass="recent-projects-table">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="recentProjectNameColumn" text="%startScreen.column.name" prefWidth="180"/>
                                <TableColumn fx:id="recentProjectFolderColumn" text="%startScreen.column.folder" prefWidth="400"/>
                                <TableColumn fx:id="recentProjectLastOpenedColumn" text="%startScreen.column.lastOpened" prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
                <TabPane fx:id="tabPane"/>
            </StackPane>
        </center>
        <bottom>
            <HBox>
                <Label fx:id="statusLabel"/>
            </HBox>
        </bottom>
    </BorderPane>
</Scene>